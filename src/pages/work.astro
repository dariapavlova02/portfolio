---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/projects";
---

<BaseLayout title="Work — Daria Pavlova" description="Selected data infrastructure, search and semantic systems work by Daria Pavlova.">
	<Header current="work" />
	<main id="main-content" class="interior-page page-frame">
		<header class="interior-intro">
			<p class="eyebrow" data-reveal>Work</p>
			<h1 data-reveal style="--reveal-delay: 80ms">Systems, evidence{" "}<br />and engineering decisions.</h1>
			<p data-reveal style="--reveal-delay: 160ms">Each project has a case study covering the problem, the approach and the outcome. Repositories are added as they are made public.</p>
		</header>
		<section class="project-list" aria-label="Projects">
			{projects.map((project) => <ProjectRow project={project} />)}
		</section>
	</main>
	<Footer />
</BaseLayout>
