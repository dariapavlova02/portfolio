---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import PublicationRegister from "../components/PublicationRegister.astro";
import { publications } from "../data/publications";
---

<BaseLayout
	title="Research — Daria Pavlova"
	description="Published research and evidence-led technical evaluation by data engineer Daria Pavlova."
>
	<Header current="research" />
	<main id="main-content" class="interior-page page-frame">
		<header class="interior-intro research-index-intro" data-motion>
			<p class="eyebrow">Research</p>
			<h1>Published work and technical evaluation records.</h1>
			<p>Research across semantic systems, DeFi data and applied machine learning, with reported claims kept separate from current reproducible evidence.</p>
		</header>

		<PublicationRegister publications={publications} />
	</main>
	<Footer />
</BaseLayout>
