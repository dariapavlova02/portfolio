---
import BaseLayout from "../layouts/BaseLayout.astro";
import EditorialIntro from "../components/EditorialIntro.astro";
import FeaturedEvidence from "../components/FeaturedEvidence.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import ProjectRow from "../components/ProjectRow.astro";
import { projects } from "../data/projects";
---

<BaseLayout>
	<Header current="home" />
	<main id="main-content">
		<EditorialIntro />
		<FeaturedEvidence project={projects[0]} />

		<section class="selected-work page-frame" id="work" aria-labelledby="work-title" data-motion>
			<header class="section-header">
				<h2 class="mono-label" id="work-title">Selected work</h2>
				<a class="arrow-link arrow-link--compact" href="/work">
					<span>View all work</span><span aria-hidden="true">→</span>
				</a>
			</header>

			<div class="project-list">
				{projects.map((project) => <ProjectRow project={project} />)}
			</div>
		</section>

		<section class="more-work page-frame" aria-label="More work" data-motion>
			<span class="more-work-mark" aria-hidden="true">↗</span>
			<p>More case studies, technical notes<br />and experiments.</p>
			<a class="arrow-link arrow-link--compact" href="/work">
				<span>View all work</span><span aria-hidden="true">→</span>
			</a>
		</section>
	</main>
	<Footer />
</BaseLayout>
