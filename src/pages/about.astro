---
import BaseLayout from "../layouts/BaseLayout.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { contactChannels } from "../config";
---

<BaseLayout title="About — Daria Pavlova" description="Professional background, experience and education of data engineer Daria Pavlova.">
	<Header current="about" />
	<main id="main-content" class="interior-page page-frame">
		<header class="interior-intro interior-intro--wide" data-motion>
			<p class="eyebrow">About</p>
			<h1>I work on systems where data scale, retrieval quality and correctness become engineering constraints.</h1>
		</header>

		<section class="records-section" aria-labelledby="experience-title" data-motion data-trace-rule>
			<h2 class="mono-label" id="experience-title">Experience</h2>
			<article class="professional-record">
				<p class="record-date">2026 — Now</p>
				<div>
					<p class="mono-label">iPay.ua</p>
					<h3>Data Engineer</h3>
				</div>
				<div class="record-detail">
					<p>Large-scale transaction and regulatory data infrastructure.</p>
					<a href="/work/nbu-registry-export">Selected work → NBU Registry Export</a>
				</div>
			</article>
		</section>

		<section class="records-section" aria-labelledby="education-title" data-motion data-trace-rule>
			<h2 class="mono-label" id="education-title">Education</h2>
			<article class="professional-record">
				<p class="record-date">MSc</p>
				<div>
					<p class="mono-label">Jožef Stefan International Postgraduate School</p>
					<h3>Information and Communication Technologies</h3>
				</div>
				<div class="record-detail">
					<p>Leakage-aware evaluation of graph-derived features for DeFi incident severity prediction, following work published at Information Society 2025.</p>
					<a href="/research">Research → Publications and evaluation</a>
				</div>
			</article>
		</section>

		<section class="utility-record" id="cv" aria-labelledby="cv-title" data-motion data-trace-rule>
			<h2 class="mono-label" id="cv-title">CV</h2>
			<p>The downloadable CV will be connected here when the final file is supplied.</p>
		</section>

		<section class="contact-record" id="contact" aria-labelledby="contact-title" data-motion data-trace-rule>
			<div class="contact-record-intro">
				<h2 class="mono-label" id="contact-title">Contact</h2>
				<p>For engineering roles, research collaboration and carefully scoped project work.</p>
			</div>
			<div class="contact-channel-list">
				{contactChannels.map((channel) => (
					<a class="contact-channel" href={channel.href} title={channel.detail}
						aria-label={`${channel.name}: ${channel.detail}`}
						target={channel.href.startsWith("https:") ? "_blank" : undefined}
						rel={channel.href.startsWith("https:") ? "noreferrer" : undefined}>
						<span class="mono-label">{channel.name}</span>
						<span class="contact-channel-detail">{channel.detail}</span>
						<span class="contact-channel-arrow" aria-hidden="true">↗</span>
					</a>
				))}
			</div>
		</section>
	</main>
	<Footer />
</BaseLayout>

<style>
	.contact-record {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		column-gap: var(--grid-gap);
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		padding-block: clamp(2.8rem, 4.5vw, 4.5rem);
	}

	.contact-record-intro {
		grid-column: 1 / 6;
	}

	.contact-record-intro > p {
		max-width: 29rem;
		margin: 1.35rem 0 0;
		font-family: var(--serif);
		font-size: clamp(1.55rem, 2.15vw, 2.25rem);
		font-weight: 420;
		letter-spacing: -0.02em;
		line-height: 1.12;
		text-wrap: balance;
	}

	.contact-channel-list {
		grid-column: 7 / 13;
		border-top: 1px solid var(--rule);
	}

	.contact-channel {
		display: grid;
		grid-template-columns: 6.5rem minmax(0, 1fr) auto;
		gap: 1.25rem;
		align-items: center;
		min-height: 72px;
		border-bottom: 1px solid var(--soft-rule);
		padding-inline: 0.9rem;
		transition: background-color 180ms ease;
	}

	.contact-channel:hover,
	.contact-channel:focus-visible {
		background: color-mix(in srgb, var(--cream) 38%, transparent);
	}

	.contact-channel:focus-visible {
		outline: 1px solid var(--rule);
		outline-offset: -1px;
	}

	.contact-channel .mono-label {
		color: var(--muted);
	}

	.contact-channel-detail {
		min-width: 0;
		font-size: 0.92rem;
		overflow-wrap: anywhere;
	}

	.contact-channel-arrow {
		color: var(--accent);
		font-size: 1.3rem;
		font-weight: 350;
		line-height: 1;
	}

	@media (prefers-reduced-motion: no-preference) {
		.contact-channel-arrow {
			transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1);
		}

		.contact-channel:hover .contact-channel-arrow,
		.contact-channel:focus-visible .contact-channel-arrow {
			transform: translate(2px, -2px);
		}
	}

	@media (max-width: 720px) {
		.contact-record {
			display: block;
		}

		.contact-record-intro {
			margin-bottom: 2.8rem;
		}

		.contact-record-intro > p {
			font-size: 1.7rem;
		}

		.contact-channel {
			grid-template-columns: 1fr auto;
			gap: 0.45rem 1rem;
			min-height: 82px;
			padding-block: 0.9rem;
		}

		.contact-channel-detail {
			grid-column: 1;
		}

		.contact-channel-arrow {
			grid-column: 2;
			grid-row: 1 / 3;
		}
	}
</style>
