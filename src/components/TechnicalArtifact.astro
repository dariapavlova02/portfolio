---
import type { ArtifactKind } from "../data/projects";

interface Props {
	kind: ArtifactKind;
}

const { kind } = Astro.props;
const uid = `${kind}-${Math.random().toString(36).slice(2, 7)}`;
---

{kind === "pipeline" && (
	<svg class="technical-artifact" viewBox="0 0 640 220" role="img" aria-labelledby={`${uid}-title ${uid}-desc`}>
		<title id={`${uid}-title`}>Registry export pipeline</title>
		<desc id={`${uid}-desc`}>Extract, transform, Parquet and S3 stages with validation and StarRocks relationships.</desc>
		<defs>
			<marker id={`${uid}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
				<path d="M0,0 L8,4 L0,8" class="artifact-arrowhead" />
			</marker>
		</defs>
		<g class="artifact-lines" marker-end={`url(#${uid}-arrow)`}>
			<line x1="140" y1="56" x2="176" y2="56" />
			<line x1="300" y1="56" x2="336" y2="56" />
			<line x1="460" y1="56" x2="496" y2="56" />
		</g>
		<g class="artifact-flow">
			<line x1="140" y1="56" x2="176" y2="56" />
			<line x1="300" y1="56" x2="336" y2="56" />
			<line x1="460" y1="56" x2="496" y2="56" />
		</g>
		<g class="artifact-lines artifact-lines--secondary">
			<line x1="80" y1="82" x2="136" y2="140" />
			<line x1="240" y1="82" x2="184" y2="140" />
			<line x1="400" y1="82" x2="456" y2="140" />
			<line x1="560" y1="82" x2="504" y2="140" />
			<line x1="230" y1="162" x2="390" y2="162" />
		</g>
		<g class="artifact-boxes">
			<rect x="20" y="30" width="120" height="52" />
			<rect x="180" y="30" width="120" height="52" />
			<rect x="340" y="30" width="120" height="52" />
			<rect x="500" y="30" width="120" height="52" />
			<rect x="90" y="140" width="140" height="44" />
			<rect x="390" y="140" width="140" height="44" />
		</g>
		<g class="artifact-labels">
			<text x="80" y="61" text-anchor="middle">EXTRACT</text>
			<text x="240" y="61" text-anchor="middle">TRANSFORM</text>
			<text x="400" y="61" text-anchor="middle">PARQUET</text>
			<text x="560" y="61" text-anchor="middle">S3</text>
			<text x="160" y="167" text-anchor="middle">VALIDATION</text>
			<text x="460" y="167" text-anchor="middle">STARROCKS</text>
		</g>
	</svg>
)}

{kind === "search" && (
	<svg class="technical-artifact" viewBox="0 0 640 240" role="img" aria-labelledby={`${uid}-title ${uid}-desc`}>
		<title id={`${uid}-title`}>Illustrative hybrid search flow</title>
		<desc id={`${uid}-desc`}>A query proceeds through query understanding, candidate retrieval, entity resolution and ranking. The output associates a matched entity with an alias, identifier and source record. Not an interactive search field.</desc>
		<defs>
			<marker id={`${uid}-arrow`} markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto">
				<path d="M0,0 L8,4 L0,8" class="artifact-arrowhead" />
			</marker>
		</defs>
		<rect class="artifact-box" x="20" y="16" width="600" height="40" />
		<line class="artifact-line" x1="574" y1="16" x2="574" y2="56" />
		<text class="artifact-placeholder" x="34" y="41">Search entities, aliases, identifiers…</text>
		<circle class="artifact-line" cx="595" cy="34" r="7" />
		<line class="artifact-line" x1="600" y1="39" x2="607" y2="46" />

		<g class="artifact-lines" marker-end={`url(#${uid}-arrow)`}>
			<line x1="148" y1="112" x2="176" y2="112" />
			<line x1="304" y1="112" x2="332" y2="112" />
			<line x1="460" y1="112" x2="488" y2="112" />
		</g>
		<g class="artifact-flow">
			<line x1="148" y1="112" x2="176" y2="112" />
			<line x1="304" y1="112" x2="332" y2="112" />
			<line x1="460" y1="112" x2="488" y2="112" />
		</g>
		<g class="artifact-boxes">
			<rect x="20" y="84" width="128" height="56" />
			<rect x="176" y="84" width="128" height="56" />
			<rect x="332" y="84" width="128" height="56" />
			<rect x="488" y="84" width="128" height="56" />
		</g>
		<g class="artifact-labels">
			<text x="84" y="108" text-anchor="middle"><tspan x="84">QUERY</tspan><tspan x="84" dy="15">UNDERSTANDING</tspan></text>
			<text x="240" y="108" text-anchor="middle"><tspan x="240">CANDIDATE</tspan><tspan x="240" dy="15">RETRIEVAL</tspan></text>
			<text x="396" y="108" text-anchor="middle"><tspan x="396">ENTITY</tspan><tspan x="396" dy="15">RESOLUTION</tspan></text>
			<text x="552" y="116" text-anchor="middle">RANKING</text>
		</g>
		<g class="artifact-lines">
			<path d="M552 140 V164 H20 V176" />
			<line x1="20" y1="200" x2="620" y2="200" />
		</g>
		<g class="artifact-labels">
			<text x="20" y="193">MATCHED ENTITY</text>
			<text x="340" y="193">SUPPORTING RECORD</text>
			<text class="artifact-placeholder" x="20" y="224">alias · identifier</text>
			<text class="artifact-placeholder" x="340" y="224">source · record ID</text>
		</g>
	</svg>
)}

{kind === "graph" && (
	<svg class="technical-artifact" viewBox="0 0 640 240" role="img" aria-labelledby={`${uid}-title ${uid}-desc`}>
		<title id={`${uid}-title`}>Semantic system graph</title>
		<desc id={`${uid}-desc`}>Illustrative relationships among a wallet, transaction, contract, event, protocol and entity, with relation, source and context fields.</desc>
		<g class="artifact-lines">
			<line x1="60" y1="60" x2="160" y2="110" />
			<line x1="100" y1="170" x2="160" y2="110" />
			<line x1="230" y1="40" x2="160" y2="110" />
			<line x1="160" y1="110" x2="270" y2="160" />
			<line x1="270" y1="160" x2="330" y2="80" />
			<line x1="270" y1="160" x2="360" y2="215" />
			<line x1="330" y1="80" x2="410" y2="130" />
			<line x1="330" y1="80" x2="400" y2="40" />
			<line x1="100" y1="170" x2="50" y2="225" />
		</g>
		<g class="graph-nodes">
			<circle class="graph-node--primary" cx="160" cy="110" r="8" style="--i: 0" />
			<circle cx="60" cy="60" r="7" style="--i: 1" />
			<circle cx="100" cy="170" r="7" style="--i: 1" />
			<circle cx="230" cy="40" r="7" style="--i: 2" />
			<circle class="graph-node--primary" cx="270" cy="160" r="8" style="--i: 2" />
			<circle cx="50" cy="225" r="7" style="--i: 3" />
			<circle cx="330" cy="80" r="7" style="--i: 3" />
			<circle cx="360" cy="215" r="7" style="--i: 4" />
			<circle cx="410" cy="130" r="7" style="--i: 5" />
			<circle cx="400" cy="40" r="7" style="--i: 5" />
		</g>
		<g class="artifact-labels">
			<text x="60" y="44" text-anchor="middle">WALLET</text>
			<text x="86" y="174" text-anchor="end">TRANSACTION</text>
			<text x="146" y="114" text-anchor="end">CONTRACT</text>
			<text x="244" y="44">EVENT</text>
			<text x="270" y="186" text-anchor="middle">PROTOCOL</text>
			<text x="330" y="64" text-anchor="middle">ENTITY</text>
		</g>
		<line class="artifact-line" x1="470" y1="30" x2="470" y2="210" />
		<g class="artifact-labels">
			<text x="490" y="52">RELATION</text>
			<text class="artifact-placeholder" x="490" y="74">entity → entity</text>
			<text x="490" y="112">SOURCE</text>
			<text class="artifact-placeholder" x="490" y="134">on-chain event</text>
			<text x="490" y="172">CONTEXT</text>
			<text class="artifact-placeholder" x="490" y="194">semantic model</text>
		</g>
	</svg>
)}
