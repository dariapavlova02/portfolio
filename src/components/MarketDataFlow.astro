---
import DiagramArrow from "./DiagramArrow.astro";
---

<div class="study-flow study-flow--market" aria-label="Market data pipeline: source APIs, validation and transformation, and analytical views">
	<div class="study-stage study-stage--source" data-motion>
		<p class="study-stage-label"><span>01</span> Source APIs</p>
		<div class="study-stage-content">
			<h3>Market &amp; protocol data</h3>
			<p>CoinGecko<br />DeFiLlama<br />DexScreener</p>
			<DiagramArrow class="study-link--out" />
		</div>
	</div>
	<div class="study-stage study-stage--models" data-motion>
		<p class="study-stage-label"><span>02</span> Data processing</p>
		<div class="study-models">
			<div class="study-model">
				<h3>Validate</h3>
				<p>Completeness, consistency, timeliness and outliers.</p>
			</div>
			<div class="study-model study-model--enriched">
				<DiagramArrow class="study-link--down" />
				<h3>Transform</h3>
				<p>Normalize timestamps, derive features and aggregate.</p>
			</div>
		</div>
	</div>
	<div class="study-stage study-stage--evaluation" data-motion>
		<p class="study-stage-label"><span>03</span> Analytical delivery</p>
		<div class="study-stage-content">
			<h3>Coordinated views</h3>
			<p>Overview, time series, movers and categories.</p>
			<span class="study-constraint">Four connected analytical outputs</span>
			<DiagramArrow class="study-link--in" />
		</div>
	</div>
</div>
