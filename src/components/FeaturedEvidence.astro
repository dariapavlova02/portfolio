---
import type { Project } from "../data/projects";

interface Props {
	project: Project;
}

const { project } = Astro.props;
---

<section class="featured-evidence page-frame" aria-labelledby="featured-title" data-motion>
	<div class="featured-index mono-label">{project.number}</div>
	<div class="featured-summary">
		<p class="mono-label">Featured project</p>
		<h2 id="featured-title">{project.title}</h2>
		<p class="featured-category">Large-scale data infrastructure</p>
		<a class="arrow-link" href={`/work/${project.slug}`}>
			<span>View case study</span><span aria-hidden="true">→</span>
		</a>
	</div>
	<div class="featured-scale">
		<p class="mono-label">Scale</p>
		<p class="scale-value">≈500,000,000</p>
		<p class="scale-unit">records</p>
		<p class="scale-context">
			Multi-year regulatory dataset exported under memory and compute constraints
			with strict validation requirements.
		</p>
	</div>
</section>
