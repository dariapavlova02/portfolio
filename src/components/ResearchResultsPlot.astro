<div class="research-plots" aria-label="Corrected model comparison charts">
	<figure class="research-plot">
		<figcaption>
			<span class="mono-label">Chronological holdout</span>
			<span>AUC · axis 0.70–0.85</span>
		</figcaption>
		<div class="plot-scale" aria-hidden="true"><span>0.70</span><span>0.85</span></div>
		<div class="plot-row" aria-label="Baseline AUC 0.823">
			<span>Baseline</span>
			<span class="plot-track"><span class="plot-fill" style="--plot-value: 82%"></span><span class="plot-dot" style="--plot-position: 82%"></span></span>
			<strong>0.823</strong>
		</div>
		<div class="plot-row" aria-label="Graph-enriched AUC 0.817">
			<span>Graph-enriched</span>
			<span class="plot-track"><span class="plot-fill plot-fill--accent" style="--plot-value: 78%"></span><span class="plot-dot plot-dot--accent" style="--plot-position: 78%"></span></span>
			<strong>0.817</strong>
		</div>
	</figure>

	<figure class="research-plot">
		<figcaption>
			<span class="mono-label">Expanding-window CV</span>
			<span>Mean AUC ± std · axis 0.60–0.90</span>
		</figcaption>
		<div class="plot-scale" aria-hidden="true"><span>0.60</span><span>0.90</span></div>
		<div class="plot-row plot-row--interval" aria-label="Baseline AUC 0.775 plus or minus 0.090">
			<span>Baseline</span>
			<span class="plot-track"><span class="plot-range" style="--range-left: 28%; --range-width: 60%"></span><span class="plot-dot" style="--plot-position: 58%"></span></span>
			<strong>0.775</strong>
		</div>
		<div class="plot-row plot-row--interval" aria-label="Graph-enriched AUC 0.787 plus or minus 0.074">
			<span>Graph-enriched</span>
			<span class="plot-track"><span class="plot-range plot-range--accent" style="--range-left: 38%; --range-width: 49%"></span><span class="plot-dot plot-dot--accent" style="--plot-position: 62%"></span></span>
			<strong>0.787</strong>
		</div>
	</figure>
</div>
