---
const comparisons = [
	{
		title: "Chronological holdout",
		note: "AUC on the held-out period",
		models: [
			{ name: "Baseline", mean: 0.823, deviation: 0 },
			{ name: "Graph-enriched", mean: 0.817, deviation: 0 },
		],
	},
	{
		title: "Temporal cross-validation",
		note: "Mean AUC ± standard deviation · 5 folds",
		models: [
			{ name: "Baseline", mean: 0.775, deviation: 0.090 },
			{ name: "Graph-enriched", mean: 0.787, deviation: 0.074 },
		],
	},
];
const position = (value: number) => `${((value - 0.6) / 0.3) * 100}%`;
---

<div class="model-comparisons" aria-label="Corrected model comparison; both charts use an AUC scale from 0.60 to 0.90">
	{comparisons.map((comparison) => (
		<figure class="model-chart" data-motion="chart">
			<figcaption>
				<h3>{comparison.title}</h3>
				<p>{comparison.note}</p>
			</figcaption>
			<div class="model-chart-axis" aria-hidden="true">
				{["0.60", "0.70", "0.80", "0.90"].map((tick) => <span>{tick}</span>)}
			</div>
			{comparison.models.map((model, index) => (
				<div class:list={["model-chart-row", { "model-chart-row--enriched": index === 1 }]}
					style={`--chart-delay: ${index * 140}ms`}
					aria-label={`${model.name}: AUC ${model.mean.toFixed(3)}${model.deviation ? `, standard deviation ${model.deviation.toFixed(3)}` : ""}`}>
					<span class="model-chart-label">{model.name}</span>
					<div class="model-chart-track" aria-hidden="true">
						{model.deviation > 0 && <span class="model-chart-range" style={`left: ${position(model.mean - model.deviation)}; width: ${(model.deviation * 2 / 0.3) * 100}%`} />}
						<span class="model-chart-dot" style={`left: ${position(model.mean)}`} />
					</div>
					<span class="model-chart-value">{model.mean.toFixed(3)}</span>
				</div>
			))}
		</figure>
	))}
</div>
