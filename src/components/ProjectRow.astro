---
import type { Project } from "../data/projects";
import TechnicalArtifact from "./TechnicalArtifact.astro";

interface Props {
	project: Project;
}

const { project } = Astro.props;
const artifactLabels = {
	pipeline: "Export pipeline",
	search: "Retrieval flow",
	graph: "Semantic relationships",
};
---

<article class:list={["project-row", `project-row--${project.artifact}`]} id={project.slug} aria-labelledby={`${project.slug}-title`}>
	<p class="project-number" aria-hidden="true">{project.number}</p>
	<div class="project-copy">
		<p class="mono-label">{project.category}</p>
		<h3 id={`${project.slug}-title`}>{project.title}</h3>
		<p class="project-description">{project.description}</p>
		<div class="project-links">
			<a href={`/work#${project.slug}`}>Case study</a>
			<span aria-hidden="true">·</span>
			{project.repositoryUrl ? (
				<a href={project.repositoryUrl} target="_blank" rel="noreferrer">Repository</a>
			) : (
				<span class="pending-link">Repository pending</span>
			)}
		</div>
	</div>
	<figure class="project-artifact">
		<div class="artifact-canvas" tabindex="0" role="region" aria-label={`${artifactLabels[project.artifact]} diagram`}>
			<TechnicalArtifact kind={project.artifact} />
		</div>
		<figcaption>{artifactLabels[project.artifact]} <span>— provisional schematic</span></figcaption>
	</figure>
</article>
