---
import "@fontsource-variable/inter";
import "@fontsource-variable/source-serif-4";
import "@fontsource/ibm-plex-mono/400.css";
import "@fontsource/ibm-plex-mono/500.css";
import "../styles/global.css";
import "../styles/evidence.css";
import "../styles/motion.css";
import { siteConfig } from "../config";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = siteConfig.title,
	description = siteConfig.description,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? siteConfig.siteUrl);
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	"@id": `${siteConfig.siteUrl}#person`,
	name: siteConfig.name,
	url: siteConfig.siteUrl,
	jobTitle: "Data Engineer",
	sameAs: [siteConfig.githubUrl, siteConfig.linkedinUrl],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalUrl} />
		<meta name="theme-color" content="#fff5f5" />
		<link rel="icon" type="image/svg+xml" sizes="any" href="/favicon-dp.svg" />
		<link rel="shortcut icon" type="image/x-icon" sizes="32x32" href="/favicon-dp.ico" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
		<script is:inline>
			(() => {
				const isReload = performance.getEntriesByType("navigation")[0]?.type === "reload";
				history.scrollRestoration = isReload ? "manual" : "auto";
				if (!isReload) return;
				// Cancel both saved scroll position and fragment scrolling before layout.
				if (location.hash) history.replaceState(history.state, "", location.pathname + location.search);
				window.scrollTo({ top: 0, left: 0, behavior: "instant" });
			})();
		</script>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
		<script is:inline>
			(() => {
				const initializePage = () => {
					if (performance.getEntriesByType("navigation")[0]?.type === "reload") {
						window.scrollTo({ top: 0, left: 0, behavior: "instant" });
					}
					const header = document.querySelector("[data-sticky-header]");
					if (header) {
						const updateHeader = () => header.classList.toggle("is-scrolled", window.scrollY > 12);
						updateHeader();
						window.addEventListener("scroll", updateHeader, { passive: true });
					}

					const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
					if (reducedMotion || !("IntersectionObserver" in window)) return;

					const targets = document.querySelectorAll("[data-motion], .technical-artifact");
					if (!targets.length) return;

					document.documentElement.classList.add("motion-capable");
					const observer = new IntersectionObserver(
						(entries) => {
							entries.forEach((entry) => {
								if (!entry.isIntersecting) return;
								const isGraphic = entry.target.matches(".model-chart, .technical-artifact, .study-stage");
								if (entry.intersectionRatio < (isGraphic ? 0.3 : 0.04)) return;
								entry.target.classList.add("is-in-view");
								observer.unobserve(entry.target);
							});
						},
						{ rootMargin: "0px 0px -4% 0px", threshold: [0.04, 0.3] },
					);

					targets.forEach((target) => observer.observe(target));
				};
				// Observe only after the browser has settled the initial scroll position.
				if (document.readyState === "complete") initializePage();
				else window.addEventListener("pageshow", initializePage, { once: true });
			})();
		</script>
	</body>
</html>
